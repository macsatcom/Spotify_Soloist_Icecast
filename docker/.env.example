# --- Host paths (persisted volumes) ---
DATA_DIR=./data          # config.json, secrets.json, soloist binary (bin/), Spotify session
CACHE_DIR=./cache        # Soloist playback cache

# --- Web UI / API ---
WEB_PORT=8380

# --- Icecast ---
ICECAST_MODE=internal    # internal | external
ICECAST_HOST=127.0.0.1   # external mode only
ICECAST_PORT=8100
ICECAST_MOUNT=/spotify
ICECAST_SOURCE=changeme
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASS=changeme_admin

# --- Optional first-run seed (afterwards managed in the web UI) ---
SOLOIST_API_KEY=

TZ=Europe/Copenhagen
